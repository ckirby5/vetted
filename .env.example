# .env.example (pseudocode/template — commit this, never the real .env)

POSTGRES_USER=<placeholder>
POSTGRES_PASSWORD=<placeholder>
POSTGRES_DB=vetted

# built from the above, or set separately — pick one convention and stay consistent
DATABASE_URL=postgresql://<user>:<password>@postgres:5432/<db>

ELASTICSEARCH_URL=http://elasticsearch:9200

# for later, once OAuth is wired up
OAUTH_CLIENT_ID=<placeholder>
OAUTH_CLIENT_SECRET=<placeholder>